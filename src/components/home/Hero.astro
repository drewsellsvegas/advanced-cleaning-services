---
import { withBase } from '../../lib/paths';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import CallButton from '../ui/CallButton.astro';
import TextButton from '../ui/TextButton.astro';
import Button from '../ui/Button.astro';
import { phoneDisplay, telHref, callAria } from '../../lib/contact';
import PhoneMockup from './PhoneMockup.astro';

// Home hero (PLAN 6.1). The H1 is the LCP element and is never animated or hidden.
// Lead, buttons and bullets use the on-load .hero-in keyframe. The phone shows the exact default text the Text buttons open.
const bullets = ['Free estimates', 'Send photos by text', 'Serving the entire Valley'];
---
<Section tone="white" padding="hero" labelledby="hero-heading">
  <Container>
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4">Las Vegas Valley · Carpet, Tile &amp; More</p>
        <h1 id="hero-heading" class="text-display-h1">Las Vegas Carpet &amp; Tile Cleaning, Done with Care</h1>
        <p class="lead hero-in mt-5 max-w-[40ch] md:max-w-[52ch]" style="--hero-i:1">
          Carpet, rugs, upholstery, tile, grout and exterior surfaces, cleaned by a local team that treats your home like their own. Text Miguel a few photos for a free estimate.
        </p>
        <div class="hero-in mt-7" style="--hero-i:2">
          <div class="flex gap-3 sm:flex-wrap">
            <CallButton size="lg" class="flex-1 sm:flex-none" />
            <TextButton size="lg" class="flex-1 sm:flex-none" />
          </div>
          <p class="mt-3 hidden text-small text-subtle lg:block">
            On a computer? Text <a href={telHref()} aria-label={callAria(phoneDisplay)} class="underline underline-offset-2 hover:text-ink">{phoneDisplay}</a> from your phone.
          </p>
        </div>
        <div class="hero-in mt-8" style="--hero-i:3">
          <ul class="flex flex-col gap-3 md:flex-row md:flex-wrap md:gap-x-7">
            {bullets.map((b) => (
              <li class="flex items-center gap-2.5 font-semibold text-ink">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gold-50 text-gold-700">
                  <Icon name="check" size={16} />
                </span>
                {b}
              </li>
            ))}
          </ul>
          <Button variant="link" href={withBase('/services')} class="mt-6">See all services</Button>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="flex items-center justify-center rounded-xl border border-gold-100 bg-gold-50 px-6 py-8 lg:py-10">
          <PhoneMockup />
        </div>
      </div>
    </div>
  </Container>
</Section>
