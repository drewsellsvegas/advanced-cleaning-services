---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import CallButton from '../ui/CallButton.astro';
import TextButton from '../ui/TextButton.astro';
import { phoneDisplay } from '../../lib/contact';

// Closing CTA band (PLAN 6.11): night background, decorative gold sparkle, H2, lead, two buttons.
interface Props {
  heading?: string;
  lead?: string;
  smsMessage?: string;
  id?: string;
}
const {
  heading = 'Ready for Cleaner Floors?',
  lead = 'Call or text Miguel today for a free estimate. Send photos and we\'ll take it from there.',
  smsMessage,
  id = 'cta-heading'
} = Astro.props;
---
<Section tone="night" padding="none" class="py-20 lg:py-28" labelledby={id}>
  <Container>
    <div class="mx-auto max-w-[45rem] text-center">
      <div data-reveal style="--i:0">
        <svg class="mx-auto mb-5 text-gold-500" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M12 0c.6 6.2 5.8 11.4 12 12-6.2.6-11.4 5.8-12 12-.6-6.2-5.8-11.4-12-12C6.2 11.4 11.4 6.2 12 0z" />
        </svg>
        <h2 id={id} class="mx-auto text-white">{heading}</h2>
        <p class="lead mx-auto mt-4 text-night-text!">{lead}</p>
      </div>
      <div data-reveal style="--i:1" class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <TextButton size="lg" message={smsMessage} />
        <CallButton size="lg" variant="ghost-light" label={`Call ${phoneDisplay}`} />
      </div>
    </div>
  </Container>
</Section>
