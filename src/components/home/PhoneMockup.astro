---
import Icon from '../ui/Icon.astro';
import site from '../../data/site.json';

// Hero phone (CSS drawn, no image): a phone showing an example text conversation.
// The chat is anchored to the bottom of the screen so the top is cropped, like a real thread scrolled to the latest messages.
// The first (cropped) bubble is the exact default text the "Text" buttons open (site.sms.defaultMessage).
// No price appears: pricing is not confirmed (PLAN rule: no invented prices). Replies are deliberately generic.
// Only opacity animates (typing dots); everything else is static.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const sent = site.sms.defaultMessage.trim();
const reply = "Thanks for the photos! I'll send your free estimate shortly. What day works for you?";
const followUp = 'Great, any chance for Monday morning?';
---
<div
  role="img"
  aria-label={`Example text conversation with ${site.phone.display}. The customer writes: ${sent} and attaches four photos. The reply reads: ${reply} The customer answers: ${followUp}`}
  class:list={['phone hero-in mx-auto', className]}
  style="--hero-i:3.5; animation-duration:600ms"
>
  <div class="phone-body" aria-hidden="true">
    <div class="phone-screen">
      <div class="phone-island"></div>
      <div class="px-6 pb-2 pt-12 text-center text-[13px] font-semibold text-ink">{site.phone.display}</div>

      <div class="phone-chat">
        <div class="ml-auto max-w-[88%] rounded-[18px] rounded-br-[4px] bg-gold-500 px-3.5 py-2.5 text-[13px] leading-snug text-ink">
          {sent}
        </div>
        <div class="ml-auto grid w-[78%] grid-cols-2 gap-1.5">
          <span class="phone-photo"><Icon name="camera" size={20} /></span>
          <span class="phone-photo phone-photo-b"><Icon name="camera" size={20} /></span>
          <span class="phone-photo phone-photo-b"><Icon name="camera" size={20} /></span>
          <span class="phone-photo"><Icon name="camera" size={20} /></span>
        </div>
        <div class="max-w-[88%] rounded-[18px] rounded-bl-[4px] bg-[#ececec] px-3.5 py-2.5 text-[13px] leading-snug text-ink">
          {reply}
        </div>
        <div class="ml-auto max-w-[80%] rounded-[18px] rounded-br-[4px] bg-gold-500 px-3.5 py-2.5 text-[13px] leading-snug text-ink">
          {followUp}
        </div>
      </div>

      <div class="flex items-center gap-2 border-t border-line px-3 pb-5 pt-2.5">
        <span class="flex-1 rounded-full border border-line bg-cream px-3 py-2 text-[11px] text-muted">Text Message</span>
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink text-white"><Icon name="message-square-text" size={14} /></span>
      </div>
    </div>

  </div>
</div>

<style>
  .phone { width: 100%; max-width: 270px; }
  .phone-body {
    position: relative;
    background: #111;
    border-radius: 2.6rem;
    padding: 0.6rem;
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.28), 0 0 0 1px rgb(0 0 0 / 0.5);
  }
  .phone-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 2.1rem;
    overflow: hidden;
    height: 520px;
  }
  .phone-island {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 78px;
    height: 22px;
    margin-left: -39px;
    background: #111;
    border-radius: 999px;
    z-index: 2;
  }
  .phone-chat {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.6rem;
    overflow: hidden;
    padding: 0 0.75rem 0.9rem;
  }
  .phone-photo {
    display: flex;
    aspect-ratio: 1 / 1;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    background: #e3ddd0;
    color: #6b665c;
  }
  .phone-photo-b { background: #d6d0c4; }
</style>
