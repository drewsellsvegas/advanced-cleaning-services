---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Icon from '../ui/Icon.astro';
import CallButton from '../ui/CallButton.astro';
import TextButton from '../ui/TextButton.astro';
import ExampleTextCard from '../ui/ExampleTextCard.astro';
import { phoneDisplay, telHref, callAria } from '../../lib/contact';
import { renderInline } from '../../lib/text';
import { showOptional } from '../../lib/placeholder';
import type { Crumb } from '../../lib/schema';

// Service / area page hero (PLAN 7.1, 7.2). Breadcrumbs, eyebrow, H1, intro, Call + Text buttons, trust bullets.
// Visual: the real photo when one exists, otherwise the gold-50 panel with the example-text card (PLAN 8).
// The H1 and image are never animated; lead, buttons and bullets use the on-load .hero-in keyframe (PLAN 4.3).
interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  h1: string;
  intro: string;
  smsMessage: string;
  /** Real photo metadata, if any. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Lucide icon shown large in the placeholder panel. */
  icon?: string;
  /** Aspect of the photo / panel on lg. */
  aspect?: '4/3' | '4/5';
  headingId?: string;
}
const { crumbs, eyebrow, h1, intro, smsMessage, image, imageAlt = '', icon, aspect = '4/3', headingId = 'page-heading' } = Astro.props;
const bullets = ['Free estimates', 'Send photos by text', 'Serving the entire Valley'];
const aspectClass = aspect === '4/5' ? 'aspect-[4/5]' : 'aspect-[4/3]';
---
<Section tone="white" padding="none" class="pb-16 pt-4 lg:pb-24" labelledby={headingId}>
  <Container>
    <Breadcrumbs crumbs={crumbs} class="mb-6 lg:mb-8" />
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="eyebrow mb-4">{eyebrow}</p>
        <h1 id={headingId} class="max-w-[22ch]">{h1}</h1>
        {showOptional(intro) && (
          <p class="lead hero-in mt-5 max-w-[52ch]" style="--hero-i:1" set:html={renderInline(intro)} />
        )}
        <div class="hero-in mt-7" style="--hero-i:2">
          <div class="flex gap-3 sm:flex-wrap">
            <CallButton size="lg" class="flex-1 sm:flex-none" />
            <TextButton size="lg" class="flex-1 sm:flex-none" message={smsMessage} />
          </div>
          <p class="mt-3 hidden text-small text-subtle lg:block">
            On a computer? Text <a href={telHref()} aria-label={callAria(phoneDisplay)} class="underline underline-offset-2 hover:text-ink">{phoneDisplay}</a> from your phone.
          </p>
        </div>
        <ul class="hero-in mt-8 flex flex-col gap-3 md:flex-row md:flex-wrap md:gap-x-7" style="--hero-i:3">
          {bullets.map((b) => (
            <li class="flex items-center gap-2.5 font-semibold text-ink">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gold-50 text-gold-700">
                <Icon name="check" size={16} />
              </span>
              {b}
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-5">
        {image ? (
          <Picture
            src={image}
            alt={imageAlt}
            formats={['avif', 'webp']}
            widths={[400, 640, 920]}
            sizes="(min-width: 1024px) 460px, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class:list={['h-auto w-full rounded-xl object-cover', aspectClass]}
          />
        ) : (
          <div class:list={['relative flex flex-col items-center justify-center gap-6 rounded-xl border border-gold-100 bg-gold-50 p-6 lg:p-8', aspect === '4/5' ? 'lg:aspect-[4/5]' : 'lg:aspect-[4/3]']}>
            {icon && <Icon name={icon} size={64} class="hidden text-gold-600 lg:block" />}
            <ExampleTextCard message={smsMessage.replace(/\s*My ZIP code is:\s*$/, '')} />
          </div>
        )}
      </div>
    </div>
  </Container>
</Section>
