---
import Icon from './Icon.astro';
import { isSet } from '../../lib/placeholder';
import { renderInline } from '../../lib/text';

// "Example text" card (PLAN 6.1 / 7.1): a customer bubble with two decorative photo tiles and Miguel's reply bubble.
// The reply is a placeholder (Q5): shown highlighted in dev, omitted in production until the client supplies it.
interface Props {
  /** Customer bubble text. */
  message: string;
  class?: string;
}
const { message, class: className } = Astro.props;
const reply = "[PLACEHOLDER: Miguel's typical reply, e.g. 'Thanks! I'll send your estimate shortly.']";
const showReply = isSet(reply) || import.meta.env.DEV;
---
<div
  role="img"
  aria-label="Example: a customer texts photos to Miguel and gets an estimate by text"
  class:list={['hero-in w-full max-w-[280px] rounded-lg bg-white p-4 shadow-md', className]}
  style="--hero-i:3.75; animation-duration:600ms"
>
  <p class="mb-3 text-[13px] leading-snug text-subtle">Example text estimate</p>
  <div class="ml-auto w-[88%] rounded-lg rounded-br-sm bg-gold-50 p-3 text-[14px] leading-snug text-ink">
    {message.trim()}
    <div class="mt-2 flex gap-2" aria-hidden="true">
      <span class="flex h-14 w-14 items-center justify-center rounded-md bg-line text-muted"><Icon name="camera" size={20} /></span>
      <span class="flex h-14 w-14 items-center justify-center rounded-md bg-line text-muted"><Icon name="camera" size={20} /></span>
    </div>
  </div>
  {showReply && (
    <div class="mt-3 w-[88%] rounded-lg rounded-bl-sm bg-cream p-3 text-[14px] leading-snug text-ink" set:html={renderInline(reply)} />
  )}
</div>
