---
import { withBase } from '../../lib/paths';
import Icon from '../ui/Icon.astro';
import TextButton from '../ui/TextButton.astro';
import CallButton from '../ui/CallButton.astro';
import { getAreas, getServicesByGroup } from '../../lib/data';
import { phoneDisplay } from '../../lib/contact';

// Mobile menu sheet (PLAN 3.13), below lg. Behaviour lives in src/scripts/mobile-menu.ts.
// Hidden with visibility (discrete) + opacity/translateY transition; the script sets `top` from the header bottom.
interface Props {
  smsMessage?: string;
}
const { smsMessage } = Astro.props;
const groups = await getServicesByGroup();
const areas = await getAreas();
const row = 'flex min-h-14 items-center border-b border-line text-h4 font-semibold text-ink';
---
<div id="mobile-menu" class="mobile-menu fixed inset-x-0 bottom-0 z-[45] overflow-y-auto overscroll-contain bg-white lg:hidden" data-mobile-menu>
  <nav aria-label="Mobile" class="container-site pb-[calc(1.5rem+env(safe-area-inset-bottom))] pt-2">
    <details class="menu-acc border-b border-line">
      <summary class={`${row} cursor-pointer justify-between border-b-0`}>
        Services<Icon name="chevron-down" size={24} class="chev text-ink-soft" />
      </summary>
      <div class="pb-4">
        <a href={withBase('/services')} class="flex min-h-12 items-center text-base font-semibold text-gold-700 underline underline-offset-[3px]">All services</a>
        {groups.map((g) => (
          <div class="mt-3">
            <p class="eyebrow px-0 py-2">{g.group}</p>
            <ul>
              {g.services.map((s) => (
                <li>
                  <a href={withBase(`/services/${s.slug}`)} class="flex min-h-12 items-center gap-3 text-base font-medium text-ink">
                    <Icon name={s.icon} size={20} class="shrink-0 text-gold-700" />{s.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </details>
    <details class="menu-acc border-b border-line">
      <summary class={`${row} cursor-pointer justify-between border-b-0`}>
        Service Areas<Icon name="chevron-down" size={24} class="chev text-ink-soft" />
      </summary>
      <div class="pb-4">
        <ul class="grid grid-cols-2 gap-x-4">
          {areas.map((a) => (
            <li>
              <a href={withBase(`/service-areas/${a.slug}`)} class="flex min-h-12 items-center gap-2 text-base font-medium text-ink">
                <Icon name="map-pin" size={20} class="shrink-0 text-gold-700" />{a.name}
              </a>
            </li>
          ))}
        </ul>
        <a href={withBase('/service-areas')} class="mt-1 flex min-h-12 items-center text-base font-semibold text-gold-700 underline underline-offset-[3px]">All service areas</a>
      </div>
    </details>
    <a href={withBase('/free-estimate')} class={row}>Free Estimate</a>
    <a href={withBase('/about')} class={row}>About</a>
    <a href={withBase('/contact')} class={row}>Contact</a>
    <div class="mt-6 flex flex-col gap-3">
      <TextButton size="lg" message={smsMessage} class="w-full" />
      <CallButton size="lg" label={`Call ${phoneDisplay}`} class="w-full" />
    </div>
  </nav>
</div>
