---
import { withBase } from '../../lib/paths';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Prose from '../../components/ui/Prose.astro';
import Icon from '../../components/ui/Icon.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import AreaCard from '../../components/ui/AreaCard.astro';
import Button from '../../components/ui/Button.astro';
import Faq from '../../components/ui/Faq.astro';
import TextEstimatePanel from '../../components/home/TextEstimatePanel.astro';
import CtaBand from '../../components/home/CtaBand.astro';
import { getArea, getAreas, getServices } from '../../lib/data';
import type { Area } from '../../lib/data';
import { realImage } from '../../lib/images';
import { isSet, showOptional } from '../../lib/placeholder';
import { stripInline } from '../../lib/text';
import { areaServiceNode, faqPage } from '../../lib/schema';

// Area page template (PLAN 7.2). Same placeholder policy as the service template: placeholder prose shows
// (highlighted) in dev only; sections with no real content are omitted in production and tones re-alternate.
export async function getStaticPaths() {
  const areas = await getAreas();
  return areas.map((a) => ({ params: { slug: a.slug }, props: { slug: a.slug } }));
}
const { slug } = Astro.props as { slug: string };
const a = (await getArea(slug)) as Area;
const [allAreas, allServices] = await Promise.all([getAreas(), getServices()]);

const path = `/service-areas/${a.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Service Areas', path: '/service-areas' },
  { name: a.name, path }
];
const containedShort = a.containedIn.replace(/,\s*Nevada.*$/, '');

const local = a.local.filter((p) => showOptional(p));
const neighborhoods = a.neighborhoods.filter((n) => showOptional(n));
const faq = a.faq.filter((f) => showOptional(f.q) && showOptional(f.a));
const popular = a.popularServices.map((s) => allServices.find((x) => x.slug === s)).filter(Boolean) as typeof allServices;
const nearby = a.nearbyAreas.map((n) => allAreas.find((x) => x.slug === n)).filter(Boolean) as Area[];
// Link to the main Las Vegas page unless this is that page or it is already one of the nearby cards.
const showMainLink = !a.isMain && !a.nearbyAreas.includes('las-vegas');

// Sections after the hero alternate cream, white, cream ... in the order of 7.2, skipping omitted ones.
const sequence = [
  'services',
  (local.length > 0 || neighborhoods.length > 0) && 'local',
  'estimate',
  faq.length > 0 && 'faq',
  'nearby'
].filter(Boolean) as string[];
const tone = Object.fromEntries(sequence.map((k, i) => [k, i % 2 === 0 ? 'cream' : 'white'])) as Record<string, 'white' | 'cream'>;

const ctaHeading = isSet(a.ctaHeadline) ? a.ctaHeadline : undefined;
const schema = [areaServiceNode(a), faqPage(faq.map((f) => ({ q: f.q, a: stripInline(f.a) })))];
const image = realImage(a.image);
---
<BaseLayout
  title={a.title}
  description={a.metaDescription}
  path={path}
  breadcrumbs={crumbs}
  schema={schema}
  smsMessage={a.smsMessage}
>
  <PageHero
    crumbs={crumbs}
    eyebrow={`Service area · ${containedShort}`}
    h1={a.h1}
    intro={a.heroIntro}
    smsMessage={a.smsMessage}
    image={image}
    imageAlt={a.image?.alt ?? ''}
    icon="map-pin"
  />

  <Section tone={tone.services} labelledby="services-heading">
    <Container>
      <SectionHeader
        id="services-heading"
        heading={`Cleaning Services in ${a.name}`}
        lead={showOptional(a.servicesIntro) ? a.servicesIntro : undefined}
      />
      <div class="grid gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3 lg:gap-8">
        {popular.map((s, i) => <ServiceCard service={s} index={i % 3} />)}
      </div>
      <p class="mt-10 lg:mt-14"><Button variant="link" href={withBase('/services')}>See all 12 services</Button></p>
    </Container>
  </Section>

  {tone.local && (
    <Section tone={tone.local} labelledby="local-heading">
      <Container>
        {local.length > 0 && (
          <>
            <SectionHeader id="local-heading" heading={a.localHeading} />
            <Prose paragraphs={local} class="max-w-[68ch]" />
          </>
        )}
        {neighborhoods.length > 0 && (
          <div class:list={[local.length > 0 && 'mt-14']}>
            <h2 id={local.length > 0 ? 'neighborhoods-heading' : 'local-heading'} class="mb-6">Neighborhoods We Serve in {a.name}</h2>
            <ul data-reveal class="flex flex-wrap gap-3">
              {neighborhoods.map((n) => (
                <li class="chip hover:translate-y-0!">
                  <Icon name="map-pin" size={16} class="text-gold-700" />{n}
                </li>
              ))}
            </ul>
          </div>
        )}
      </Container>
    </Section>
  )}

  <TextEstimatePanel
    tone={tone.estimate}
    heading={`How to Get a Free Estimate in ${a.name}`}
    lead={a.estimateCopy}
    smsMessage={a.smsMessage}
  />

  {tone.faq && (
    <Section tone={tone.faq} labelledby="faq-heading">
      <Container>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-5">
            <SectionHeader id="faq-heading" heading={`${a.name} Cleaning FAQs`} />
          </div>
          <div class="lg:col-span-7"><Faq items={faq} /></div>
        </div>
      </Container>
    </Section>
  )}

  <Section tone={tone.nearby} labelledby="nearby-heading">
    <Container>
      <SectionHeader id="nearby-heading" heading="Nearby Areas We Serve" />
      <div class="grid gap-4 md:grid-cols-3 md:gap-6 lg:gap-8">
        {nearby.map((n, i) => <AreaCard area={n} index={i} />)}
      </div>
      {showMainLink && (
        <p class="mt-10"><Button variant="link" href={withBase('/service-areas/las-vegas')}>Cleaning in Las Vegas, NV</Button></p>
      )}
    </Container>
  </Section>

  <CtaBand heading={ctaHeading} smsMessage={a.smsMessage} />
</BaseLayout>
